# Environment type
NODE_ENV=development

# Frontend URL (Vite dev server) — used for CORS
NETLIFY_URL=http://localhost:3001

# Secret key used to sign JWTs — generate your own, e.g. `openssl rand -hex 48`
JWT_SECRET=replace_with_a_long_random_string

# MongoDB connection string
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/movie-explorer

# Port for the backend server
PORT=5500

# OMDb API key — get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
