# Environment type
NODE_ENV=development

# Optional comma-separated frontend origins for split frontend/API deployments.
# Leave unset in production when Express serves the built frontend.
FRONTEND_URL=http://localhost:3001

# Secret key used to sign JWTs — generate your own, e.g. `openssl rand -hex 48`
JWT_SECRET=replace_with_a_long_random_string

# MongoDB connection string
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/movie-explorer

# Port for the backend server. Hosting providers such as Render set this.
PORT=5500

# OMDb API key — get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
