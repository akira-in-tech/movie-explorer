{
  "name": "movie-explorer",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "build": "npm --prefix client run build",
    "test": "node --test server/tests/*.test.js",
    "check": "npm test && npm run build",
    "admin:promote": "node server/scripts/promote-admin.js",
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "movies",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Akira",
  "license": "MIT",
  "description": "A full-stack movie discovery app with authentication, reviews, bookmarks, and admin-curated featured content.",
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
